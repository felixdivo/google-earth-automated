// Usage, options, security defaults, and tips: https://github.com/bare-devcontainer/templates/tree/main/src/uv
// What is installed in the image, and available tags: https://github.com/bare-devcontainer/images
{
  "name": "Python (uv)",
  "image": "ghcr.io/bare-devcontainer/uv:trixie",
  "containerUser": "root",
  "remoteUser": "root",
  "init": true,
  // /dev/fuse + CAP_SYS_ADMIN: Earth Studio's local Image Sequence render asks
  // for an output folder via the File System Access API, which Chromium
  // confirms through xdg-desktop-portal's Documents portal -- that portal
  // FUSE-mounts an export dir to hand the chosen path back, and without a real
  // FUSE device + the capability to mount it, that confirmation hangs forever
  // (see the Security section in README.md for the tradeoff this accepts).
  "runArgs": ["--device=/dev/fuse", "--cap-add=SYS_ADMIN"],
  "containerEnv": {
    "UV_LINK_MODE": "copy"
  },
  "mounts": [
    {
      "source": "${devcontainerId}-uv-cache",
      "target": "/root/.cache/uv",
      "type": "volume"
    },
    {
      "source": "${devcontainerId}-claude-data",
      "target": "/root/.claude",
      "type": "volume"
    }
  ],
  "onCreateCommand": "apt-get update && apt-get install -y --no-install-recommends libglib2.0-0t64 libnspr4 libnss3 libatk1.0-0t64 libatk-bridge2.0-0t64 libdbus-1-3 libcups2t64 libxcb1 libxkbcommon0 libasound2t64 libgbm1 libx11-6 libxext6 libcairo2 libpango-1.0-0 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 libatspi2.0-0t64 xvfb x11vnc novnc websockify fluxbox xdotool libgtk-3-0t64 dbus dbus-x11 xdg-desktop-portal xdg-desktop-portal-gtk && uv run playwright install chromium",
  // The claude-data volume starts empty on first mount (Docker only seeds a
  // new volume from the image, not from a live container), so restore the
  // one-time stash left in the (already-persistent) uv-cache volume the
  // first time this fires.
  "postCreateCommand": "if [ ! -e /root/.claude/projects ] && [ -d /root/.cache/uv/claude-backup ]; then cp -a /root/.cache/uv/claude-backup/. /root/.claude/; fi",
  "postStartCommand": "sh .devcontainer/start-vnc.sh",
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "noVNC (headed browser)",
      "onAutoForward": "silent"
    }
  },
  "remoteEnv": {
    "DISPLAY": ":99",
    "XDG_RUNTIME_DIR": "/tmp/runtime-root",
    "DBUS_SESSION_BUS_ADDRESS": "unix:path=/tmp/dbus-session-bus"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "Anthropic.claude-code"
      ],
      "settings": {
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.fixAll": "explicit",
            "source.organizeImports": "explicit"
          }
        }
      }
    }
  }
}
